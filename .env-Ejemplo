# Configuración general y de red
TZ=America/Argentina/Buenos_Aires
N8N_PORT=5678
N8N_VERSION=latest
N8N_DATA_PATH=./n8n_data

# IPs de los equipos
N8N_VM_IP=192.168.1.100       # <--- IP de ESTA máquina (donde corre n8n)
OLLAMA_REMOTE_IP=192.168.1.50   # <--- IP del OTRO equipo (donde corre Ollama)

# Seguridad de n8n
N8N_ENCRYPTION_KEY=cambia_esta_clave_por_una_segura_y_larga
WEBHOOK_URL=http://${N8N_VM_IP}:${N8N_PORT}/
